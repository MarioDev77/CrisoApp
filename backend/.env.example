# Copie para .env (local) ou configure no painel do Railway. NUNCA commite valores reais.
# Nenhuma variável aqui usa o prefixo NEXT_PUBLIC_: tudo é privado do servidor.

DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DB_POOL_MAX=10

# Gere com: openssl rand -base64 48   (mínimo 32 caracteres)
JWT_SECRET=

# Segredos separados: gere localmente com `node scripts/gerar-chaves.mjs` e
# configure somente no cofre/painel do serviço. Nunca compartilhe valores reais.
SESSION_SECRET=
SESSION_SECRET_PREV=
OTP_PEPPER=
QR_SIGNING_SECRET=
DATA_ENCRYPTION_KEYS=
BLIND_INDEX_KEY=
ORIGIN_SECRET=
CRON_SECRET=

# Admin inicial (usado só por `npm run db:seed` quando não existe admin).
# Se a senha tiver "#" ou espaços, coloque o valor entre aspas: ADMIN_SENHA="abc#123..."
ADMIN_EMAIL=
ADMIN_SENHA=

# Proxy confiável (define de onde vem o IP do cliente para rate limit/auditoria):
#   none        -> não confia em nenhum cabeçalho (todos os IPs viram "desconhecido")
#   cloudflare  -> usa CF-Connecting-IP (só se a origem aceitar tráfego APENAS da Cloudflare)
#   hops        -> usa X-Forwarded-For contando TRUSTED_PROXY_HOPS saltos a partir da direita
TRUSTED_PROXY=none
TRUSTED_PROXY_HOPS=1

# E-mail de recuperação de senha (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Login com Google (o client id é público por natureza, mas é servido por /api/auth/google/client-id)
GOOGLE_CLIENT_ID=
# Login com Google fica desligado por padrão. Só "true" ativa (precisa do GOOGLE_CLIENT_ID).
GOOGLE_LOGIN_ATIVO=false

# Durante a migração do front antigo (HTML) o token ainda pode ser devolvido no JSON.
# Em produção com o front React: false (só cookie HttpOnly).
LEGACY_BEARER=false

APP_TIMEZONE=America/Sao_Paulo
QR_MAX_UNIDADES_POR_MATERIAL=200

# Origens extras autorizadas a fazer POST/PUT/DELETE em /api (separadas por vírgula, sem barra final).
# Necessário quando o front fica na Vercel e repassa /api para este backend.
ALLOWED_ORIGINS=https://criso-app.vercel.app

# MFA: "admin_loja" (padrão) exige segundo fator de lojas e admins; "admin" só de admins; "todos" inclui os clientes.
MFA_ESCOPO=admin_loja
